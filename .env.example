# ============================================================================
# TZW FEMS - Environment Configuration (sample)
# Copy this file to `.env` and adjust the values for your environment.
# NEVER commit the real `.env` file. Secrets must live in environment vars.
# ============================================================================

# ---- Runtime ----
NODE_ENV=development

# ---- Database (shared PostgreSQL instance) ----
# In production each microservice would own its database; for the academic
# deployment a single instance with logical separation is used.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fems
POSTGRES_USER=fems_app
POSTGRES_PASSWORD=change_me_in_production
DATABASE_URL=postgresql://fems_app:change_me_in_production@localhost:5432/fems

# ---- JWT / Auth ----
JWT_ACCESS_SECRET=replace_with_a_long_random_access_secret
JWT_REFRESH_SECRET=replace_with_a_long_random_refresh_secret
JWT_ACCESS_TTL=900            # access token lifetime in seconds (15 min)
JWT_REFRESH_TTL=604800        # refresh token lifetime in seconds (7 days)
BCRYPT_ROUNDS=12

# ---- Service ports ----
GATEWAY_PORT=8080
AUTH_PORT=4001
USER_PORT=4002
EXTINGUISHER_PORT=4003
INSPECTION_PORT=4004
NOTIFICATION_PORT=4005
REPORTING_PORT=4006
REQUEST_PORT=4007

# ---- Internal service URLs (used by gateway + cross-service calls) ----
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
EXTINGUISHER_SERVICE_URL=http://localhost:4003
INSPECTION_SERVICE_URL=http://localhost:4004
NOTIFICATION_SERVICE_URL=http://localhost:4005
REPORTING_SERVICE_URL=http://localhost:4006
REQUEST_SERVICE_URL=http://localhost:4007

# ---- SMTP (registration OTP + invitations) ----
# Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords — use that 16-char password as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=TZW FEMS <your-email@gmail.com>
APP_PUBLIC_URL=http://localhost:5173

# ---- Security ----
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
RATE_LIMIT_MAX=500            # max requests per window per IP
AUTH_RATE_LIMIT_MAX=20        # stricter limit for auth endpoints

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8080/api/v1
